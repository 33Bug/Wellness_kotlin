<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".DailyMotivation">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Motivation"
        android:textSize="30sp"
        android:padding="20dp"
        android:textColor="#536DFE"
        android:textStyle="bold"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/img4"
        android:scaleType="centerCrop"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• Emphasize progress over perfection and focus on the journey rather than just the destination.
        •Build consistent habits, as excellence stems from repeated actions (Aristotle).
        •Remember that you don't need to fix everything immediately; just move one thing forward in the right direction."
        android:textSize="16sp"
        android:layout_margin="10dp"
        android:textColor="#B3745B"/>

    <SeekBar
        android:id="@+id/daily_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="12"
        android:progress="8"
        android:layout_margin="10dp"/>

    <CheckBox
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I have reached my daily  goal"
        android:textColor="#234254"
        android:padding="10dp"
        android:textSize="10sp"/>

    <Button
        android:id="@+id/daily_goals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily goals"
        android:backgroundTint="#2E0E08"
        android:textSize="18sp"
        android:layout_margin="10dp"/>



</LinearLayout>