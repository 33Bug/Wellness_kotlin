<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".NutritionAdvice">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nutritional Advice"
        android:textSize="30sp"
        android:padding="20dp"
        android:textColor="#536DFE"
        android:textStyle="bold"/>


    <TextView
        android:id="@+id/nutrition_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Water helps in digesting of food and cooling of the body.It is taken by whole of humanity as it is essential for survival.It also aids in growth of industries which leads to more money."
        android:layout_margin="5dp"/>

    <Button
        android:id="@+id/reward_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Watch and get rewarded"
        android:layout_margin="30dp"/>


</LinearLayout>